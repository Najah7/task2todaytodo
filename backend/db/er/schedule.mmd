erDiagram
    %% users, projects and tags are reference-only entities owned by other diagrams.
    users {
        text id PK "NOT NULL"
    }

    projects {
        text id PK "NOT NULL"
        text user_id "NOT NULL"
    }

    tags {
        text id PK "NOT NULL"
        text user_id "NOT NULL"
    }

    timezone_master {
        text timezone PK "NOT NULL"
    }

    schedule_blueprints {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz created_at "NOT NULL"
    }

    schedule_blueprint_revisions {
        text id PK "NOT NULL"
        text blueprint_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        integer revision "NOT NULL"
        date effective_from "NOT NULL"
        date recurrence_anchor_date "NOT NULL"
        timestamp local_start "NOT NULL"
        timestamp local_end "NOT NULL"
        text timezone FK "NOT NULL"
        text frequency "NOT NULL"
        integer interval_count "NOT NULL"
        text_array weekdays "NOT NULL"
        date end_date "NULL"
        date cutoff_after "NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        timestamptz superseded_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    schedules {
        text id PK "NOT NULL"
        text blueprint_id FK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        text timezone FK "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz skipped_at "NULL"
        timestamptz deleted_at "NULL"
        boolean is_override "NOT NULL"
        integer revision "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    schedule_revisions {
        text schedule_id PK, FK "NOT NULL"
        integer revision PK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id "NULL"
        text assignee_id FK "NOT NULL"
        text timezone FK "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz skipped_at "NULL"
        timestamptz deleted_at "NULL"
        boolean is_override "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz changed_at "NOT NULL"
    }

    schedule_project_pause_intervals {
        text project_id PK, FK "NOT NULL"
        text blueprint_id PK, FK "NOT NULL"
        timestamptz paused_at PK "NOT NULL"
        timestamptz resumed_at "NULL"
        text paused_by FK "NOT NULL"
        text resumed_by FK "NULL"
    }

    schedule_backfill_checkpoints {
        text revision_id PK, FK "NOT NULL"
        date through_date "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    schedule_tag_assignments {
        text blueprint_id PK, FK "NOT NULL"
        text tag_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    users ||--o{ schedule_blueprints : owns
    schedule_blueprints ||--o{ schedule_blueprint_revisions : defines
    users ||--o{ schedule_blueprint_revisions : owns
    projects |o--o{ schedule_blueprint_revisions : assigned_project
    timezone_master ||--o{ schedule_blueprint_revisions : local_time_zone
    users ||--o{ schedule_blueprint_revisions : assignee
    schedule_blueprints ||--o{ schedules : generates
    schedule_blueprint_revisions ||--o{ schedules : source_definition
    projects |o--o{ schedules : assigned_project
    timezone_master ||--o{ schedules : snapshot_time_zone
    users ||--o{ schedules : assignee
    schedules ||--o{ schedule_revisions : audit
    timezone_master ||--o{ schedule_revisions : audited_time_zone
    schedule_blueprints ||--o{ schedule_project_pause_intervals : paused_in_project
    projects ||--o{ schedule_project_pause_intervals : pauses
    schedule_blueprint_revisions ||--o| schedule_backfill_checkpoints : backfill_checkpoint
    schedule_blueprints ||--o{ schedule_tag_assignments : tagged
    tags ||--o{ schedule_tag_assignments : assigned_tag
