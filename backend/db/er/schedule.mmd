    users ||..o{ schedule_exceptions : owned_by
    projects |o..o{ schedule_exceptions : assigned_project_owner_pair
    users ||..o{ schedule_exceptions : assigned_to
    timezone_master ||..o{ schedule_exceptions : snapshot_timezone
    users ||..o{ schedule_exceptions : changed_by
    projects ||--o{ schedule_project_pause_intervals : paused_project
    schedule_rules ||--o{ schedule_project_pause_intervals : paused_rule
    users ||..o{ schedule_project_pause_intervals : paused_by
    users |o..o{ schedule_project_pause_intervals : resumed_by
    schedule_rule_revisions ||--o| schedule_backfill_checkpoints : backfill_checkpoint
