erDiagram
    %% External entities are reference-only: users/projects/tags are in auth/project/task diagrams;
    %% frequency_master is defined in task.mmd and list links in todolist.mmd.
    %% Composite unique key: schedules(id, user_id).
    %% Composite FKs: schedules(project_id, user_id) -> projects(id, user_id);
    %% schedules(series_id, user_id) -> schedules(id, user_id).
    %% Composite unique key: schedules(id, user_id).
    %% Partial unique index: schedules(series_id, occurrence_date), only when id <> series_id.

    users {
        text id PK "NOT NULL"
    }

    projects {
        text id PK "NOT NULL"
        text user_id "NOT NULL"
    }

    frequency_master {
        text frequency PK "NOT NULL"
    }

    tags {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
    }

    schedules {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text series_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        text timezone "NOT NULL"
        boolean is_exception "NOT NULL"
        text repeat_state "NULL"
        date frequency_anchor_date "NULL"
        integer interval_weeks "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz skipped_at "NULL"
        integer revision "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    schedule_revisions {
        text id PK, FK "NOT NULL"
        integer revision PK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id "NULL"
        text assignee_id FK "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text series_id "NOT NULL"
        date occurrence_date "NOT NULL"
        text timezone "NOT NULL"
        boolean is_exception "NOT NULL"
        text repeat_state "NULL"
        date frequency_anchor_date "NULL"
        integer interval_weeks "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz skipped_at "NULL"
        text[] frequencies "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz changed_at "NOT NULL"
    }

    schedule_frequencies {
        text schedule_id PK, FK "NOT NULL"
        text frequency PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    schedule_tag_assignments {
        text schedule_id PK, FK "NOT NULL"
        text tag_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    users ||..o{ schedules : owns
    users ||..o{ schedules : assignee
    users ||..o{ schedules : changed_by
    projects |o..o{ schedules : optional_project_owner_pair
    schedules ||..o{ schedules : series_parent_same_owner
    schedules ||--o{ schedule_frequencies : repeats_on
    frequency_master ||--o{ schedule_frequencies : used_by_schedule
    schedules ||--o{ schedule_revisions : has_revisions
    users ||..o{ schedule_revisions : changed_by
    schedules ||--o{ schedule_tag_assignments : has_tags
    tags ||--o{ schedule_tag_assignments : assigned_to_schedules
