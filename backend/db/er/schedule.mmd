    %% Tables created by 000004_schedule.up.sql.
    %% External references: users (auth.mmd), projects (project.mmd), timezone_master (auth.mmd).
    %% Composite unique keys: schedule_rules(id, user_id), schedule_rule_revisions(id, rule_id, user_id), schedules(id, rule_id), schedules(rule_id, occurrence_date).
    %% schedule_exceptions key (rule_id, occurrence_date) also references schedules(rule_id, occurrence_date).

    users {
        text id PK "NOT NULL"
    }

    projects {
        text id PK "NOT NULL"
        text user_id "NOT NULL"
    }

    timezone_master {
        text timezone PK "NOT NULL"
    }

    schedule_rules {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz created_at "NOT NULL"
    }

    schedule_rule_revisions {
        text id PK "NOT NULL"
        text rule_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        integer revision "NOT NULL"
        date effective_from "NOT NULL"
        date recurrence_anchor_date "NOT NULL"
        timestamp local_start "NOT NULL"
        timestamp local_end "NOT NULL"
        boolean all_day "NOT NULL"
        text timezone FK "NOT NULL"
        text frequency "NOT NULL"
        integer interval_count "NOT NULL"
        text_array weekdays "NOT NULL"
        date end_date "NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        timestamptz superseded_at "NULL"
        date cutoff_after "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    schedules {
        text id PK "NOT NULL"
        text rule_id FK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        boolean all_day "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        text timezone FK "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz skipped_at "NULL"
        timestamptz deleted_at "NULL"
        integer revision "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    schedule_revisions {
        text schedule_id PK, FK "NOT NULL"
        integer revision PK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        boolean all_day "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id "NULL"
        text assignee_id FK "NOT NULL"
        text timezone FK "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz skipped_at "NULL"
        timestamptz deleted_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz changed_at "NOT NULL"
    }

    schedule_exceptions {
        text rule_id PK, FK "NOT NULL"
        date occurrence_date PK, FK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        boolean all_day "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        text location "NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        text timezone FK "NOT NULL"
        boolean completed "NOT NULL"
        timestamptz skipped_at "NULL"
        timestamptz deleted_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    schedule_project_pause_intervals {
        text project_id PK, FK "NOT NULL"
        text rule_id PK, FK "NOT NULL"
        timestamptz paused_at PK "NOT NULL"
        timestamptz resumed_at "NULL"
        text paused_by FK "NOT NULL"
        text resumed_by FK "NULL"
    }

    schedule_backfill_checkpoints {
        text revision_id PK, FK "NOT NULL"
        date through_date "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    users ||..o{ schedule_rules : owns
    schedule_rules ||..o{ schedule_rule_revisions : revision_of_rule
    users ||..o{ schedule_rule_revisions : owned_by
    projects |o..o{ schedule_rule_revisions : assigned_project_owner_pair
    timezone_master ||..o{ schedule_rule_revisions : local_timezone
    users ||..o{ schedule_rule_revisions : assigned_to
    users ||..o{ schedule_rule_revisions : changed_by
    schedule_rules ||..o{ schedules : generates
    schedule_rule_revisions ||..o{ schedules : source_definition
    users ||..o{ schedules : owned_by
    projects |o..o{ schedules : assigned_project_owner_pair
    users ||..o{ schedules : assigned_to
    timezone_master ||..o{ schedules : snapshot_timezone
    users ||..o{ schedules : changed_by
    schedules ||--o{ schedule_revisions : has_revisions
    schedule_rule_revisions ||..o{ schedule_revisions : source_definition
    users ||..o{ schedule_revisions : owned_by
    users ||..o{ schedule_revisions : assigned_to
    timezone_master ||..o{ schedule_revisions : snapshot_timezone
    users ||..o{ schedule_revisions : changed_by
    schedule_rules ||..o{ schedule_exceptions : exception_for_rule
