erDiagram
    %% External references: users, projects, priority_master, roles, and project_members.
    %% Composite FK: tasks(project_id, user_id) -> projects(id, user_id).
    %% Composite self-FK: todo_items(series_id, task_id) -> todo_items(id, task_id).
    %% Composite unique keys: tags(user_id, name), todo_items(id, task_id).
    %% Partial unique index: todo_items(series_id, occurrence_date), only when id <> series_id.

    users {
        text id PK "NOT NULL"
    }

    projects {
        text id PK "NOT NULL"
        text user_id "NOT NULL"
    }

    priority_master {
        text priority PK "NOT NULL"
    }

    status_master {
        text status PK "NOT NULL"
        text label "NOT NULL"
        text label_jp "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    frequency_master {
        text frequency PK "NOT NULL"
        text label "NOT NULL"
        text label_jp "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    tasks {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NULL"
        text assignee_id FK "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        date due_date "NULL"
        integer estimated_minutes "NULL"
        integer actual_minutes "NULL"
        text priority FK "NOT NULL"
        text status FK "NOT NULL"
        integer revision "NOT NULL"
        timestamptz deleted_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    task_revisions {
        text id PK, FK "NOT NULL"
        integer revision PK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id "NULL"
        text assignee_id FK "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        date due_date "NULL"
        integer estimated_minutes "NULL"
        integer actual_minutes "NULL"
        text priority "NOT NULL"
        text status "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz changed_at "NOT NULL"
    }

    tags {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        citext name "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    task_tag_assignments {
        text task_id PK, FK "NOT NULL"
        text tag_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    todo_items {
        text id PK "NOT NULL"
        text task_id FK "NOT NULL"
        text title "NOT NULL"
        text description "NULL"
        date due_date "NULL"
        boolean completed "NOT NULL"
        integer position "NOT NULL"
        text series_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        text timezone "NOT NULL"
        boolean is_exception "NOT NULL"
        text repeat_state "NULL"
        date frequency_anchor_date "NULL"
        integer interval_weeks "NOT NULL"
        timestamptz deleted_at "NULL"
        timestamptz skipped_at "NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    todo_item_frequencies {
        text todo_item_id PK, FK "NOT NULL"
        text frequency PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    users ||..o{ tasks : owns
    users ||..o{ tasks : assignee
    users ||..o{ tasks : changed_by
    projects |o..o{ tasks : optional_project_owner_pair
    priority_master ||..o{ tasks : prioritizes
    status_master ||..o{ tasks : status
    tasks ||--o{ task_revisions : has_revisions
    users ||..o{ task_revisions : changed_by
    users ||..o{ tags : owns
    tasks ||--o{ task_tag_assignments : has_tags
    tags ||--o{ task_tag_assignments : assigned_to_tasks
    tasks ||..o{ todo_items : contains
    todo_items ||..o{ todo_items : series_parent_same_task
    todo_items ||--o{ todo_item_frequencies : repeats_on
    frequency_master ||--o{ todo_item_frequencies : used_by_item
