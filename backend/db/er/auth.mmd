erDiagram
    %% Composite unique constraint: permissions(resource_id, action, effect).
    %% projects.type and projects.priority reference task-schema master tables, omitted from this auth view.
    users {
        text id PK "NOT NULL"
        text first_name "NOT NULL"
        text last_name "NOT NULL"
        citext email UK "NOT NULL"
        text password "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
        text timezone "NOT NULL"
    }

    access_tokens {
        text token PK "NOT NULL"
        text user_id FK "NOT NULL"
        timestamptz expires_at "NOT NULL"
        timestamptz revoked_at "NULL"
        timestamptz created_at "NOT NULL"
    }

    roles {
        text role_id PK "NOT NULL"
        text name UK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    managed_resources {
        text resource_id PK "NOT NULL"
        text name UK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    permissions {
        bigint permission_id PK "NOT NULL"
        text resource_id FK, UK "NOT NULL"
        permission_action action UK "NOT NULL"
        permission_effect effect UK "NOT NULL"
        text description "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    role_permissions {
        text role_id PK, FK "NOT NULL"
        bigint permission_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    projects {
        text id PK, UK "NOT NULL"
        text user_id FK, UK "NOT NULL"
        text type FK "NOT NULL"
        text title "NOT NULL"
        text goal "NULL"
        text description "NULL"
        text priority FK "NOT NULL"
        date start_date "NULL"
        date end_date "NULL"
        integer revision "NOT NULL"
        timestamptz deleted_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    project_members {
        text project_id PK, FK "NOT NULL"
        text user_id PK, FK "NOT NULL"
        text role_id FK "NOT NULL"
        text added_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    users ||..o{ access_tokens : owns
    managed_resources ||..o{ permissions : defines
    roles ||--o{ role_permissions : grants
    permissions ||--o{ role_permissions : granted_as
    users ||..o{ projects : owns
    users ||..o{ projects : changed_by
    projects ||--o{ project_members : has_members
    users ||--o{ project_members : member
    users ||..o{ project_members : added_by
    roles ||..o{ project_members : role
