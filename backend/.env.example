POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=task2todaytodo
POSTGRES_SSLMODE=disable
SERVER_ADDR=:8080

# Structured JSON logs are written to stdout.
OTEL_SERVICE_NAME=api
ENVIRONMENT=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# Local development defaults to no trace exporter. Set OTEL_TRACES_EXPORTER=otlp
# and an OTLP endpoint to export traces to an external Collector. From the Air
# container, host.docker.internal reaches a Collector running on the host.
OTEL_TRACES_EXPORTER=none
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_ENDPOINT=http://host.docker.internal:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://host.docker.internal:4318/v1/traces
# OTEL_EXPORTER_OTLP_HEADERS=authorization=Bearer%20token
# OTEL_EXPORTER_OTLP_TIMEOUT=10000
# OTEL_EXPORTER_OTLP_COMPRESSION=gzip
# OTEL_RESOURCE_ATTRIBUTES=team=platform
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
# OTEL_EXPORTER_OTLP_CERTIFICATE=/path/to/collector-ca.pem
# OTEL_EXPORTER_OTLP_CLIENT_CERTIFICATE=/path/to/client.pem
# OTEL_EXPORTER_OTLP_CLIENT_KEY=/path/to/client-key.pem

# Replace sample value with output of: openssl rand -base64 32
PAGE_TOKEN_KEY=REPLACE_WITH_OUTPUT_OF_OPENSSL_RAND_BASE64_32

PROJECT_ROOT=/Users/<user>/task2todaytodo/backend
