---
import '../styles/global.css';
import logo from '../../../frontend/src/assets/logo.webp';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Task2TodayToDo | 今日の計画は、もう考えなくていい。',
  description = 'やること、動かせない予定、働ける時間から、今日のTodoを自動で生成。実行できる量をひとつのリストにまとめるTask2TodayToDo。',
} = Astro.props;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content="やることと予定から、今日できるTodoを自動でつくる。計画を考える時間を、実行する時間に変えます。" />
		<meta property="og:type" content="website" />
		<meta property="og:locale" content="ja_JP" />
		<meta name="twitter:card" content="summary" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content="やることと予定から、今日できるTodoを自動でつくる。" />
		<link rel="icon" type="image/webp" href={logo.src} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link href="https://fonts.googleapis.com/css2?family=Geist:wght@400;500;600;700&display=swap" rel="stylesheet" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<slot />
		<script>
			(() => {
				const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
				const root = document.documentElement;
				const checks = [...document.querySelectorAll('#todoList input[type=checkbox]')];
				const status = document.getElementById('demoStatus');
				const resetDemo = document.getElementById('resetDemo');
				const updateDemo = () => {
					const done = checks.filter((check) => check.checked).length;
					const leftMinutes = checks.filter((check) => !check.checked).reduce((total, check) => total + Number(check.dataset.minutes), 0);
					const time = leftMinutes < 60 ? `${leftMinutes}分` : leftMinutes % 60 === 0 ? `${leftMinutes / 60}時間` : `${Math.floor(leftMinutes / 60)}時間${leftMinutes % 60}分`;
					status.textContent = done === 0 ? '今日の作業 3件・2時間' : done === checks.length ? '3件完了・すべて完了' : `完了 ${done}件・残り ${checks.length - done}件、${time}`;
				};
				checks.forEach((check) => check.addEventListener('change', updateDemo));
				resetDemo.addEventListener('click', () => {
					checks.forEach((check) => { check.checked = false; });
					updateDemo();
					checks[0].focus();
				});
				resetDemo.hidden = false;

				const toggle = document.getElementById('menuToggle');
				const overlay = document.getElementById('menuOverlay');
				const background = [document.querySelector('.skip'), document.querySelector('main'), document.querySelector('footer'), document.querySelector('.island .brand'), document.querySelector('.nav-links'), document.querySelector('.island > .button')];
				let returnFocus = null;
				const menuLinks = [...overlay.querySelectorAll('a')];
				const menuFocusOrder = [toggle, ...menuLinks];
				const setMenu = (open) => {
					root.classList.toggle('menu-open', open);
					toggle.setAttribute('aria-expanded', String(open));
					toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
					overlay.setAttribute('aria-hidden', String(!open));
					overlay.inert = !open;
					background.forEach((element) => { element.inert = open; });
					document.body.style.overflow = open ? 'hidden' : '';
					if (open) { returnFocus = document.activeElement; menuLinks[0].focus(); }
					else if (returnFocus) { returnFocus.focus(); returnFocus = null; }
				};
				toggle.addEventListener('click', () => setMenu(toggle.getAttribute('aria-expanded') !== 'true'));
				overlay.addEventListener('click', (event) => {
					if (event.target.closest('a')) setMenu(false);
				});
				document.addEventListener('keydown', (event) => {
					if (toggle.getAttribute('aria-expanded') !== 'true') return;
					if (event.key === 'Escape') { event.preventDefault(); setMenu(false); return; }
					if (event.key !== 'Tab') return;
					const first = menuFocusOrder[0], last = menuFocusOrder[menuFocusOrder.length - 1];
					if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
					else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
				});
				const desktop = window.matchMedia('(min-width: 821px)');
				desktop.addEventListener('change', (event) => {
					if (event.matches && toggle.getAttribute('aria-expanded') === 'true') {
						setMenu(false);
						if (!toggle.getClientRects().length) document.querySelector('.brand').focus();
					}
				});

				const tagline = document.getElementById('tagline');
				const words = [];
				[...tagline.querySelectorAll('.line')].forEach((line, lineIndex) => {
					const content = line.textContent.trim();
					line.textContent = '';
					content.match(/[^、。]+[、。]?/g).forEach((part) => {
						part.trim().split('').forEach((character) => {
							const span = document.createElement('span');
							span.className = `word${lineIndex === 1 ? ' accent' : ''}`;
							span.textContent = character;
							line.append(span);
							words.push(span);
						});
					});
				});

				if (!reduceMotion && 'IntersectionObserver' in window) {
					root.classList.add('reveal-ready', 'tagline-enhanced');
					const revealObserver = new IntersectionObserver((entries, observer) => {
						entries.forEach((entry) => {
							if (entry.isIntersecting) { entry.target.classList.add('visible'); observer.unobserve(entry.target); }
						});
					}, { threshold: .12, rootMargin: '0px 0px -8% 0px' });
					document.querySelectorAll('.reveal').forEach((element) => revealObserver.observe(element));
					words.forEach((word, index) => {
						const wordObserver = new IntersectionObserver((entries, observer) => {
							entries.forEach((entry) => {
								if (entry.isIntersecting) {
									window.setTimeout(() => word.classList.add('active'), Math.min(index * 24, 520));
									observer.unobserve(entry.target);
								}
							});
						}, { threshold: .8, rootMargin: '-15% 0px -15% 0px' });
						wordObserver.observe(word);
					});
				}
				if ('IntersectionObserver' in window) {
					const sections = [...document.querySelectorAll('main section[id]')];
					const navLinks = [...document.querySelectorAll('.nav-links a, .menu-overlay a[href^="#"]')];
					const navObserver = new IntersectionObserver((entries) => {
						entries.forEach((entry) => {
							if (!entry.isIntersecting) return;
							navLinks.forEach((link) => {
								if (link.getAttribute('href') === `#${entry.target.id}`) link.setAttribute('aria-current', 'true');
								else link.removeAttribute('aria-current');
							});
						});
					}, { rootMargin: '-30% 0px -60% 0px' });
					sections.forEach((section) => navObserver.observe(section));
				}
			})();
		</script>
	</body>
</html>
