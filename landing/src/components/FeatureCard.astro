---
interface Props {
	title: string;
	description: string;
	plan: 'Free' | 'Pro' | 'Team';
	icon: 'todo' | 'weekly' | 'projects' | 'schedule' | 'metrics' | 'team';
}

const { title, description, plan, icon } = Astro.props;
---

<article class="feature-card">
	<div class="feature-card-top">
		<span class="feature-icon" aria-hidden="true">
			{icon === 'todo' && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="17" rx="2" /><path d="M8 9h.01M11 9h5m-8 5h.01m3 0h5m-8 4h.01m3 0h5" /></svg>}
			{icon === 'weekly' && <svg viewBox="0 0 24 24"><rect x="3.5" y="5" width="17" height="16" rx="2" /><path d="M8 3v4m8-4v4M4 9h16M8 12h2m4 0h2m-8 4h2m4 0h2" /></svg>}
			{icon === 'projects' && <svg viewBox="0 0 24 24"><path d="M3 7a2 2 0 0 1 2-2h5l2 2h7a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" /><path d="M3 10h18" /></svg>}
			{icon === 'schedule' && <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="M12 7v5l3 2" /></svg>}
			{icon === 'metrics' && <svg viewBox="0 0 24 24"><path d="M4 19V5m0 14h17" /><path d="M8 15v-3m5 3V8m5 7v-5" /></svg>}
			{icon === 'team' && <svg viewBox="0 0 24 24"><circle cx="9" cy="8" r="3" /><path d="M3.5 19v-1a5.5 5.5 0 0 1 11 0v1z" /><path d="M16 5.5a3 3 0 0 1 0 5.8m1.5 2.2a5 5 0 0 1 3 4.5v1h-3" /></svg>}
		</span>
		<span class:list={['feature-plan', `feature-plan-${plan.toLowerCase()}`]}>{plan}</span>
	</div>
	<h3>{title}</h3>
	<p>{description}</p>
	<span class="feature-more" aria-disabled="true">
		詳しく見る<span class="sr-only">（詳細ページは準備中）</span>
		<svg aria-hidden="true" viewBox="0 0 20 20"><path d="m7 4 6 6-6 6" /></svg>
	</span>
</article>
