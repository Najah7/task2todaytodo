        timestamptz updated_at "NOT NULL"
    }

    project_time_allocation_pause_intervals {
        text project_id PK, FK "NOT NULL"
        text rule_id PK, FK "NOT NULL"
        timestamptz paused_at PK "NOT NULL"
        timestamptz resumed_at "NULL"
    }

    daily_active_time_exceptions {
        text user_id PK, FK "NOT NULL"
        date local_date PK "NOT NULL"
        timestamp active_start_local "NOT NULL"
        timestamp active_end_local "NOT NULL"
        text timezone FK "NOT NULL"
        integer revision "NOT NULL"
        timestamptz changed_at "NOT NULL"
    }

