    %% Tables created by 000007_allocation.up.sql.
    %% External references: users (auth.mmd), projects (project.mmd), timezone_master (auth.mmd).
    %% Composite keys: project_time_allocation_rules(id, user_id); project_time_allocation_rule_revisions(id, rule_id, user_id); project_time_allocations(rule_id, occurrence_date); project_time_allocation_exceptions(rule_id, occurrence_date); project_time_allocation_pause_intervals(project_id, rule_id, paused_at); daily_active_time_exceptions(user_id, local_date).
    %% Composite FKs bind rule, source revision, and user. project_time_allocation_rule_revisions also has unique keys (rule_id, revision) and (id, rule_id, user_id).

    users {
        text id PK "NOT NULL"
    }

    projects {
        text id PK "NOT NULL"
    }

    timezone_master {
        text timezone PK "NOT NULL"
    }

    project_time_allocation_rules {
        text id PK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz deleted_at "NULL"
        date stopped_after "NULL"
        text pause_reason "NULL"
        timestamptz paused_at "NULL"
    }

    project_time_allocation_plans {
        text user_id PK, FK "NOT NULL"
        text project_id PK, FK "NOT NULL"
        integer target_minutes "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    project_time_allocation_rule_revisions {
        text id PK "NOT NULL"
        text rule_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NOT NULL"
        integer revision "NOT NULL"
        date effective_from "NOT NULL"
        date recurrence_start_date "NOT NULL"
        timestamptz effective_at "NOT NULL"
        smallint weekday "NOT NULL"
        time local_start "NOT NULL"
        time local_end "NOT NULL"
        smallint end_day_offset "NOT NULL"
        text timezone FK "NOT NULL"
        text frequency "NOT NULL"
        timestamptz superseded_at "NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    project_time_allocations {
        text id PK "NOT NULL"
        text rule_id FK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NOT NULL"
        date occurrence_date "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text timezone FK "NOT NULL"
        timestamptz deleted_at "NULL"
        integer revision "NOT NULL"
        text changed_by FK "NOT NULL"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
    }

    project_time_allocation_exceptions {
        text rule_id PK, FK "NOT NULL"
        date occurrence_date PK "NOT NULL"
        text source_revision_id FK "NOT NULL"
        text user_id FK "NOT NULL"
        text project_id FK "NOT NULL"
        timestamptz start_at "NOT NULL"
        timestamptz end_at "NOT NULL"
        text timezone FK "NOT NULL"
        timestamptz deleted_at "NULL"
        text changed_by FK "NOT NULL"
