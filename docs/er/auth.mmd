erDiagram
    %% Tables created by 000001_auth.up.sql.
    %% permissions(resource_id, action, effect) is unique.

    timezone_master {
        text timezone PK "NOT NULL"
    }

    users {
        text id PK "NOT NULL"
        text first_name "NOT NULL"
        text last_name "NOT NULL"
        citext email UK "NOT NULL"
        text password_hash "NOT NULL, Argon2id PHC"
        timestamptz email_verified_at "NULL"
        bigint auth_version "NOT NULL, DEFAULT 0"
        timestamptz created_at "NOT NULL"
        timestamptz updated_at "NOT NULL"
        text timezone FK "NOT NULL"
        time wake_up_time "NOT NULL"
        time bedtime "NOT NULL"
        integer minimum_gap_minutes "NOT NULL, 0..1440"
    }

    roles {
        text role_id PK "NOT NULL"
        text name UK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    managed_resources {
        text resource_id PK "NOT NULL"
        text name UK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    permissions {
        bigint permission_id PK "NOT NULL"
        text resource_id FK "NOT NULL"
        action action "NOT NULL"
        effect effect "NOT NULL"
        text description "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    role_permissions {
        text role_id PK, FK "NOT NULL"
        bigint permission_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    system_user_roles {
        text user_id PK, FK "NOT NULL"
        text role_id PK, FK "NOT NULL"
        timestamptz created_at "NOT NULL"
    }

    personal_access_tokens {
        text token PK "NOT NULL"
        text user_id FK "NOT NULL"
        bigint auth_version "NOT NULL, DEFAULT 0"
        timestamptz expires_at "NOT NULL"
        timestamptz revoked_at "NULL"
        timestamptz created_at "NOT NULL"
    }

    auth_link_tokens {
        bytea token_hash PK "NOT NULL, SHA-256 digest"
        text user_id FK "NOT NULL"
        text purpose "NOT NULL, email_verification or password_reset"
        timestamptz expires_at "NOT NULL"
        timestamptz used_at "NULL"
        timestamptz revoked_at "NULL"
        timestamptz created_at "NOT NULL"
    }

    email_delivery_attempts {
        bytea email_hash PK "NOT NULL, SHA-256 digest with attempted_at"
        timestamptz attempted_at PK "NOT NULL"
    }

    timezone_master ||..o{ users : local_timezone
    users ||--o{ system_user_roles : system_role
    roles ||--o{ system_user_roles : assigned_system_role
    roles ||--o{ role_permissions : grants
    permissions ||--o{ role_permissions : granted_as
    managed_resources ||..o{ permissions : defines
    users ||..o{ personal_access_tokens : owns
    users ||..o{ auth_link_tokens : owns
